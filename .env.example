# CareBridge 360 Environment Configuration
# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production
PORT=5000

# Allowed CORS Origin (Optional, defaults to localhost and production domains)
CORS_ORIGIN=*

# Optional Real SMTP Email Dispatch Configuration
# When omitted, system runs in Simulated / Live Capture Mode with 100% in-app inspection
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CareBridge 360" <notifications@carebridge.health>
